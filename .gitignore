# Зависимости и сборка Next.js
node_modules/
.next/
out/
build/
*.tsbuildinfo

# Секреты и локальные настройки окружения
.env
.env.*
!.env.example

# Артефакты проверок: скриншоты QA-харнесса и отчёты Lighthouse
# (воспроизводятся командами npm run qa и npm run lh, поэтому в репозиции не нужны)
shots/
lighthouse/*.json
lighthouse/*.png

# Сырые материалы парсинга (тяжёлые, воспроизводятся скриптами из scrape/)
scrape/raw/

# Мусор ОС и редакторов
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-error.log*

# Кеши инструментов
.vercel
.eslintcache
